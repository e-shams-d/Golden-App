# Secrets and local configuration
.env
.env.*
!.env.example
!**/.env.example
*.pem
*.key
*.p12
*.pfx

# Local persistent data and runtime output. Anchor these at the repository root
# so source packages such as services/backend/app/storage remain trackable.
/.local/
/.pnpm-store/
/storage/
/logs/
/tmp/

# Redacted container logs written by infra/scripts/verify-docker.sh when the
# stack fails. Kept out of .local/ because Docker owns that directory as root.
/.verify-diagnostics/
*.log

# The queue performance measurement, written by
# tests/integration/test_queue_performance.py and read by emit_evidence.py. Out of
# .local/ for the same root-ownership reason. Ignored rather than committed because
# a measurement belongs to the run that took it: a committed figure would be
# somebody else's machine, presented as this release's evidence.
/.performance/

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
venv/
dist/
build/
*.egg-info/

# Node / Next.js / Turborepo / Playwright
node_modules/
.next/
.turbo/
out/
coverage/
playwright-report/
test-results/
*.tsbuildinfo

# Editors and operating systems
.idea/
.vscode/
.DS_Store
Thumbs.db

# Claude Code local permission allowlist. Machine-specific absolute paths, so it
# is local state rather than shared project configuration.
/.claude/
