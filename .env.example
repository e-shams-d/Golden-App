# Local-development values only. Never reuse these credentials in staging or production.
COMPOSE_PROJECT_NAME=gold-platform-local
APP_ENV=local
RELEASE_VERSION=0.1.0
RELEASE_COMMIT=unknown
APP_DEBUG=false
LOG_LEVEL=INFO
BUSINESS_TIMEZONE=Asia/Tehran

POSTGRES_DB=gold_platform
POSTGRES_USER=gold_bootstrap
POSTGRES_PASSWORD=change-me-bootstrap-local-only
APP_DB_USER=gold_app
APP_DB_PASSWORD=change-me-app-local-only
MIGRATION_DB_USER=gold_migrator
MIGRATION_DB_PASSWORD=change-me-migrator-local-only
WORKER_DB_USER=gold_worker
WORKER_DB_PASSWORD=change-me-worker-local-only
# Reads only. Operator queries and support work never connect as the app role.
READONLY_DB_USER=gold_readonly
READONLY_DB_PASSWORD=change-me-readonly-local-only
# Reads everything including audit and security history; writes nothing. The role
# existing is not a backup claim — ADR-004 is open and its safe default holds that
# a backup claim is invalid until a clean full restore drill has succeeded.
BACKUP_DB_USER=gold_backup
BACKUP_DB_PASSWORD=change-me-backup-local-only

REDIS_PASSWORD=change-me-local-only
# Relative to infra/compose/compose.local.yml. Keep runtime data outside Git.
LOCAL_DATA_ROOT=../../.local
LOCAL_STORAGE_ROOT=/app/storage
# Required for restricted dependency/worker health probes; use 32+ random characters.
OPERATIONS_HEALTH_TOKEN=change-me-operations-token-local-only-32plus
# Argon2id cost, per 12_Security_RBAC_Audit.md:381. Measured defaults: ~80-110 ms
# per verification on 8 cores. `parallelism` is baked into the hash rather than
# being a runtime knob, so the same hash costs the full serial ~350 ms on a
# single-core container -- plan capacity against that figure, not the parallel one.
# Memory is what resists GPU cracking; the floor is 64 MiB. Raising any of these is
# safe: existing hashes keep verifying and are upgraded on next successful login.
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST_KIB=65536
ARGON2_PARALLELISM=4

# A ceiling so a very long input cannot become a denial-of-service vector
# (12_Security_RBAC_Audit.md:394). The minimum length is production policy and is
# deliberately not set here.
PASSWORD_MAX_LENGTH=128

# Entropy behind each session secret. 32 bytes is a floor, not a preference: the
# stored digest is a fast unsalted hash, which is sound only because the input is
# uniform and large. No session *lifetime* setting exists -- that is ADR-SEC-002,
# which is Open.
SESSION_SECRET_BYTES=32

# Durable failed-login lockout, held in PostgreSQL because Redis has no
# persistence here (12_Security_RBAC_Audit.md:488). The threshold is never told
# to the client (:486).
AUTH_LOCKOUT_THRESHOLD=5
AUTH_LOCKOUT_SECONDS=900

# Authentication rate limiting. The two ceilings are far apart on purpose: this
# platform runs only in Iran, where carrier-grade NAT puts hundreds of unrelated
# subscribers behind one address, so a tight network ceiling locks out a carrier
# rather than an attacker. The identifier ceiling is the control; the network one
# is a backstop for a single source spraying many usernames.
AUTH_RATE_LIMIT_WINDOW_SECONDS=300
AUTH_RATE_LIMIT_IDENTIFIER_MAX=10
AUTH_RATE_LIMIT_NETWORK_MAX=300

# Required in production, 32+ random characters. Redis keys are HMACs, not raw
# identifiers: a plain hash of an Iranian mobile number is reversible by
# enumerating ~10^9 candidates.
AUTH_RATE_LIMIT_KEY_SECRET=replace-with-at-least-32-random-characters

# CSRF tokens are an HMAC of the session's stored digest under this key, bound to
# the session and validated server-side (12_Security_RBAC_Audit.md:495). Separate
# from the rate-limit key so rotating one is a local decision. Required in
# production, 32+ random characters.
AUTH_CSRF_KEY_SECRET=replace-with-at-least-32-random-characters

# PROVISIONAL. ADR-SEC-002 owns the real session timeouts and is Open, so no test
# asserts either number. Admin is shorter than trader because doc 12:460 asks for
# a stricter policy on internal sessions where reasonable: staff sit at shared
# desks, a trader is on their own phone.
ADMIN_SESSION_LIFETIME_SECONDS=28800
TRADER_SESSION_LIFETIME_SECONDS=86400


# Public browser configuration contains routing only; never put secrets in NEXT_PUBLIC_*.
NEXT_PUBLIC_API_BASE_URL=/api/v1
