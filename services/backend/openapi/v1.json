{
  "components": {
    "schemas": {
      "BackgroundProcessingResponse": {
        "additionalProperties": false,
        "properties": {
          "jobs": {
            "$ref": "#/components/schemas/JobHealth"
          },
          "needs_attention": {
            "description": "True when anything here requires an operator: a dead letter, a job awaiting manual handling, or a stale lease.",
            "title": "Needs Attention",
            "type": "boolean"
          },
          "outbox": {
            "$ref": "#/components/schemas/OutboxHealth"
          }
        },
        "required": [
          "outbox",
          "jobs",
          "needs_attention"
        ],
        "title": "BackgroundProcessingResponse",
        "type": "object"
      },
      "CenterProfileResponse": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "title": "Name",
            "type": "string"
          },
          "profile_id": {
            "format": "uuid",
            "title": "Profile Id",
            "type": "string"
          },
          "record_version": {
            "title": "Record Version",
            "type": "integer"
          },
          "replayed": {
            "title": "Replayed",
            "type": "boolean"
          }
        },
        "required": [
          "profile_id",
          "name",
          "record_version",
          "replayed"
        ],
        "title": "CenterProfileResponse",
        "type": "object"
      },
      "DependenciesResponse": {
        "additionalProperties": false,
        "properties": {
          "dependencies": {
            "additionalProperties": {
              "$ref": "#/components/schemas/DependencyStatus"
            },
            "title": "Dependencies",
            "type": "object"
          },
          "status": {
            "enum": [
              "ok",
              "degraded"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "dependencies"
        ],
        "title": "DependenciesResponse",
        "type": "object"
      },
      "DependencyStatus": {
        "additionalProperties": false,
        "properties": {
          "error_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Code"
          },
          "last_success_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Success At"
          },
          "latency_ms": {
            "title": "Latency Ms",
            "type": "number"
          },
          "required": {
            "title": "Required",
            "type": "boolean"
          },
          "status": {
            "enum": [
              "ok",
              "unavailable"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "required",
          "latency_ms"
        ],
        "title": "DependencyStatus",
        "type": "object"
      },
      "ErrorBody": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "details": {
            "items": {
              "$ref": "#/components/schemas/ErrorDetail"
            },
            "title": "Details",
            "type": "array"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "request_id": {
            "title": "Request Id",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "details",
          "request_id"
        ],
        "title": "ErrorBody",
        "type": "object"
      },
      "ErrorDetail": {
        "additionalProperties": false,
        "properties": {
          "field": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Field"
          },
          "reason": {
            "title": "Reason",
            "type": "string"
          }
        },
        "required": [
          "reason"
        ],
        "title": "ErrorDetail",
        "type": "object"
      },
      "ErrorEnvelope": {
        "additionalProperties": false,
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorEnvelope",
        "type": "object"
      },
      "JobHealth": {
        "additionalProperties": false,
        "properties": {
          "dead_lettered": {
            "title": "Dead Lettered",
            "type": "integer"
          },
          "fallback_to_manual": {
            "description": "Jobs whose handler is not retry-safe and which need a human decision.",
            "title": "Fallback To Manual",
            "type": "integer"
          },
          "oldest_queued_age_seconds": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Oldest Queued Age Seconds"
          },
          "queued": {
            "title": "Queued",
            "type": "integer"
          },
          "retry_scheduled": {
            "title": "Retry Scheduled",
            "type": "integer"
          },
          "running": {
            "title": "Running",
            "type": "integer"
          },
          "stale_leases": {
            "description": "Running jobs whose claimant stopped heartbeating. A rising number means workers are dying rather than that jobs are slow.",
            "title": "Stale Leases",
            "type": "integer"
          }
        },
        "required": [
          "queued",
          "running",
          "retry_scheduled",
          "dead_lettered",
          "fallback_to_manual",
          "stale_leases"
        ],
        "title": "JobHealth",
        "type": "object"
      },
      "LivenessResponse": {
        "additionalProperties": false,
        "properties": {
          "service": {
            "title": "Service",
            "type": "string"
          },
          "status": {
            "const": "alive",
            "default": "alive",
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "service",
          "version"
        ],
        "title": "LivenessResponse",
        "type": "object"
      },
      "OutboxHealth": {
        "additionalProperties": false,
        "properties": {
          "dead_lettered": {
            "description": "Events that exhausted delivery attempts.",
            "title": "Dead Lettered",
            "type": "integer"
          },
          "oldest_pending_age_seconds": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Age of the oldest undelivered event. Null when none are pending.",
            "title": "Oldest Pending Age Seconds"
          },
          "pending": {
            "description": "Events awaiting or retrying delivery.",
            "title": "Pending",
            "type": "integer"
          }
        },
        "required": [
          "pending",
          "dead_lettered"
        ],
        "title": "OutboxHealth",
        "type": "object"
      },
      "ReadinessResponse": {
        "additionalProperties": false,
        "properties": {
          "checks": {
            "additionalProperties": {
              "enum": [
                "ok",
                "unavailable"
              ],
              "type": "string"
            },
            "title": "Checks",
            "type": "object"
          },
          "status": {
            "enum": [
              "ready",
              "not_ready"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "checks"
        ],
        "title": "ReadinessResponse",
        "type": "object"
      },
      "ReleaseResponse": {
        "additionalProperties": false,
        "properties": {
          "built_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Built At"
          },
          "commit": {
            "title": "Commit",
            "type": "string"
          },
          "environment": {
            "title": "Environment",
            "type": "string"
          },
          "service": {
            "title": "Service",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "service",
          "version",
          "commit",
          "built_at",
          "environment"
        ],
        "title": "ReleaseResponse",
        "type": "object"
      },
      "RenameCenterProfileRequest": {
        "additionalProperties": false,
        "properties": {
          "new_name": {
            "maxLength": 200,
            "minLength": 1,
            "title": "New Name",
            "type": "string"
          },
          "profile_id": {
            "format": "uuid",
            "title": "Profile Id",
            "type": "string"
          },
          "reason": {
            "anyOf": [
              {
                "maxLength": 1000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          }
        },
        "required": [
          "profile_id",
          "new_name"
        ],
        "title": "RenameCenterProfileRequest",
        "type": "object"
      },
      "WorkerStatus": {
        "additionalProperties": false,
        "properties": {
          "active_job_count": {
            "title": "Active Job Count",
            "type": "integer"
          },
          "last_heartbeat_at": {
            "format": "date-time",
            "title": "Last Heartbeat At",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "queues": {
            "items": {
              "type": "string"
            },
            "title": "Queues",
            "type": "array"
          },
          "release_version": {
            "title": "Release Version",
            "type": "string"
          },
          "status": {
            "enum": [
              "running",
              "stale"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "name",
          "status",
          "queues",
          "last_heartbeat_at",
          "release_version",
          "active_job_count"
        ],
        "title": "WorkerStatus",
        "type": "object"
      },
      "WorkersResponse": {
        "additionalProperties": false,
        "properties": {
          "workers": {
            "items": {
              "$ref": "#/components/schemas/WorkerStatus"
            },
            "title": "Workers",
            "type": "array"
          }
        },
        "required": [
          "workers"
        ],
        "title": "WorkersResponse",
        "type": "object"
      }
    },
    "securitySchemes": {
      "OperationsToken": {
        "description": "Operations-only health access token.",
        "in": "header",
        "name": "X-Operations-Token",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "description": "Versioned operational API. Financial workflow modules are intentionally not part of the M1 runtime foundation.",
    "summary": "Manual-first settlement platform backend",
    "title": "Gold Trade Settlement Backend API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/center-profile/rename": {
      "post": {
        "operationId": "renameCenterProfile",
        "parameters": [
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Idempotency-Key"
            }
          },
          {
            "in": "header",
            "name": "If-Match",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "If-Match"
            }
          },
          {
            "in": "header",
            "name": "X-Correlation-Id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Correlation-Id"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RenameCenterProfileRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CenterProfileResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "The new name violates a business rule."
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "The operations token is invalid."
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "No such center profile."
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "The key was used for another request."
          },
          "412": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "The If-Match version is stale."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "The request failed canonical validation."
          },
          "428": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Idempotency-Key or If-Match is missing."
          }
        },
        "security": [
          {
            "OperationsToken": []
          }
        ],
        "summary": "Rename the center profile",
        "tags": [
          "center-profile"
        ]
      }
    },
    "/api/v1/health/dependencies": {
      "get": {
        "operationId": "getHealthDependencies",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DependenciesResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Operations access is denied."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "The request failed canonical validation."
          }
        },
        "security": [
          {
            "OperationsToken": []
          }
        ],
        "summary": "Dependencies",
        "tags": [
          "health"
        ]
      }
    },
    "/api/v1/health/live": {
      "get": {
        "operationId": "getHealthLiveness",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LivenessResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Live",
        "tags": [
          "health"
        ]
      }
    },
    "/api/v1/health/ready": {
      "get": {
        "operationId": "getHealthReadiness",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Ready",
        "tags": [
          "health"
        ]
      }
    },
    "/api/v1/health/workers": {
      "get": {
        "operationId": "getHealthWorkers",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkersResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Operations access is denied."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "The request failed canonical validation."
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Background processing is unavailable."
          }
        },
        "security": [
          {
            "OperationsToken": []
          }
        ],
        "summary": "Workers",
        "tags": [
          "health"
        ]
      }
    },
    "/api/v1/meta/release": {
      "get": {
        "operationId": "getReleaseMetadata",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReleaseResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Release",
        "tags": [
          "metadata"
        ]
      }
    },
    "/api/v1/operations/background-processing": {
      "get": {
        "operationId": "getBackgroundProcessingHealth",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BackgroundProcessingResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "The operations token is invalid."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "The request failed canonical validation."
          }
        },
        "security": [
          {
            "OperationsToken": []
          }
        ],
        "summary": "Outbox lag, dead letters and job queue state",
        "tags": [
          "operations"
        ]
      }
    }
  }
}
