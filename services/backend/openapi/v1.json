{
  "components": {
    "schemas": {
      "DependenciesResponse": {
        "additionalProperties": false,
        "properties": {
          "dependencies": {
            "additionalProperties": {
              "$ref": "#/components/schemas/DependencyStatus"
            },
            "title": "Dependencies",
            "type": "object"
          },
          "status": {
            "enum": [
              "ok",
              "degraded"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "dependencies"
        ],
        "title": "DependenciesResponse",
        "type": "object"
      },
      "DependencyStatus": {
        "additionalProperties": false,
        "properties": {
          "error_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Code"
          },
          "last_success_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Success At"
          },
          "latency_ms": {
            "title": "Latency Ms",
            "type": "number"
          },
          "required": {
            "title": "Required",
            "type": "boolean"
          },
          "status": {
            "enum": [
              "ok",
              "unavailable"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "required",
          "latency_ms"
        ],
        "title": "DependencyStatus",
        "type": "object"
      },
      "ErrorBody": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "details": {
            "items": {
              "$ref": "#/components/schemas/ErrorDetail"
            },
            "title": "Details",
            "type": "array"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "request_id": {
            "title": "Request Id",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "details",
          "request_id"
        ],
        "title": "ErrorBody",
        "type": "object"
      },
      "ErrorDetail": {
        "additionalProperties": false,
        "properties": {
          "field": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Field"
          },
          "reason": {
            "title": "Reason",
            "type": "string"
          }
        },
        "required": [
          "reason"
        ],
        "title": "ErrorDetail",
        "type": "object"
      },
      "ErrorEnvelope": {
        "additionalProperties": false,
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorEnvelope",
        "type": "object"
      },
      "LivenessResponse": {
        "additionalProperties": false,
        "properties": {
          "service": {
            "title": "Service",
            "type": "string"
          },
          "status": {
            "const": "alive",
            "default": "alive",
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "service",
          "version"
        ],
        "title": "LivenessResponse",
        "type": "object"
      },
      "ReadinessResponse": {
        "additionalProperties": false,
        "properties": {
          "checks": {
            "additionalProperties": {
              "enum": [
                "ok",
                "unavailable"
              ],
              "type": "string"
            },
            "title": "Checks",
            "type": "object"
          },
          "status": {
            "enum": [
              "ready",
              "not_ready"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "checks"
        ],
        "title": "ReadinessResponse",
        "type": "object"
      },
      "ReleaseResponse": {
        "additionalProperties": false,
        "properties": {
          "built_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Built At"
          },
          "commit": {
            "title": "Commit",
            "type": "string"
          },
          "environment": {
            "title": "Environment",
            "type": "string"
          },
          "service": {
            "title": "Service",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "service",
          "version",
          "commit",
          "built_at",
          "environment"
        ],
        "title": "ReleaseResponse",
        "type": "object"
      },
      "WorkerStatus": {
        "additionalProperties": false,
        "properties": {
          "active_job_count": {
            "title": "Active Job Count",
            "type": "integer"
          },
          "last_heartbeat_at": {
            "format": "date-time",
            "title": "Last Heartbeat At",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "queues": {
            "items": {
              "type": "string"
            },
            "title": "Queues",
            "type": "array"
          },
          "release_version": {
            "title": "Release Version",
            "type": "string"
          },
          "status": {
            "enum": [
              "running",
              "stale"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "name",
          "status",
          "queues",
          "last_heartbeat_at",
          "release_version",
          "active_job_count"
        ],
        "title": "WorkerStatus",
        "type": "object"
      },
      "WorkersResponse": {
        "additionalProperties": false,
        "properties": {
          "workers": {
            "items": {
              "$ref": "#/components/schemas/WorkerStatus"
            },
            "title": "Workers",
            "type": "array"
          }
        },
        "required": [
          "workers"
        ],
        "title": "WorkersResponse",
        "type": "object"
      }
    },
    "securitySchemes": {
      "OperationsToken": {
        "description": "Operations-only health access token.",
        "in": "header",
        "name": "X-Operations-Token",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "description": "Versioned operational API. Financial workflow modules are intentionally not part of the M1 runtime foundation.",
    "summary": "Manual-first settlement platform backend",
    "title": "Gold Trade Settlement Backend API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/health/dependencies": {
      "get": {
        "operationId": "getHealthDependencies",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DependenciesResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Operations access is denied."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "The request failed canonical validation."
          }
        },
        "security": [
          {
            "OperationsToken": []
          }
        ],
        "summary": "Dependencies",
        "tags": [
          "health"
        ]
      }
    },
    "/api/v1/health/live": {
      "get": {
        "operationId": "getHealthLiveness",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LivenessResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Live",
        "tags": [
          "health"
        ]
      }
    },
    "/api/v1/health/ready": {
      "get": {
        "operationId": "getHealthReadiness",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Ready",
        "tags": [
          "health"
        ]
      }
    },
    "/api/v1/health/workers": {
      "get": {
        "operationId": "getHealthWorkers",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkersResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Operations access is denied."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "The request failed canonical validation."
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Background processing is unavailable."
          }
        },
        "security": [
          {
            "OperationsToken": []
          }
        ],
        "summary": "Workers",
        "tags": [
          "health"
        ]
      }
    },
    "/api/v1/meta/release": {
      "get": {
        "operationId": "getReleaseMetadata",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReleaseResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Release",
        "tags": [
          "metadata"
        ]
      }
    }
  }
}
