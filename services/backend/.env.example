# Runtime identity
APP_ENV=local
# Canonical name: RELEASE_VERSION. APP_VERSION is accepted for Compose compatibility.
RELEASE_VERSION=0.1.0
RELEASE_COMMIT=unknown
LOG_LEVEL=INFO
APP_DEBUG=false

# Time contract: persistence/internal timestamps are UTC; business presentation is Tehran.
BUSINESS_TIMEZONE=Asia/Tehran
INTERNAL_TIMEZONE=UTC

# Backend-only dependency credentials; replace locally and never commit a real .env file.
DATABASE_URL=postgresql+psycopg://gold_app:replace-me@postgres:5432/gold_platform
REDIS_URL=redis://:replace-me@redis:6379/0

STORAGE_BACKEND=local
# Canonical name: LOCAL_STORAGE_ROOT. STORAGE_ROOT is accepted for Compose compatibility.
LOCAL_STORAGE_ROOT=/var/lib/golden/private

DEPENDENCY_TIMEOUT_SECONDS=1.5
WORKER_PROBE_TIMEOUT_SECONDS=1.5
REDIS_REQUIRED_FOR_READINESS=true

# Required in production; use at least 32 random characters.
OPERATIONS_HEALTH_TOKEN=replace-with-at-least-32-random-characters

CELERY_QUEUES=files,exports,notifications,reports,maintenance,ai
CELERY_TASK_ALWAYS_EAGER=false
