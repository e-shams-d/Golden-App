# Runtime identity
APP_ENV=local
# Canonical name: RELEASE_VERSION. APP_VERSION is accepted for Compose compatibility.
RELEASE_VERSION=0.1.0
RELEASE_COMMIT=unknown
LOG_LEVEL=INFO
APP_DEBUG=false

# Time contract: persistence/internal timestamps are UTC; business presentation is Tehran.
BUSINESS_TIMEZONE=Asia/Tehran
INTERNAL_TIMEZONE=UTC

# Backend-only dependency credentials; replace locally and never commit a real .env file.
DATABASE_URL=postgresql+psycopg://gold_app:replace-me@postgres:5432/gold_platform
REDIS_URL=redis://:replace-me@redis:6379/0

STORAGE_BACKEND=local
# Canonical name: LOCAL_STORAGE_ROOT. STORAGE_ROOT is accepted for Compose compatibility.
LOCAL_STORAGE_ROOT=/var/lib/golden/private

DEPENDENCY_TIMEOUT_SECONDS=1.5
WORKER_PROBE_TIMEOUT_SECONDS=1.5
REDIS_REQUIRED_FOR_READINESS=true

# Required in production; use at least 32 random characters.
OPERATIONS_HEALTH_TOKEN=replace-with-at-least-32-random-characters

# Argon2id cost, per 12_Security_RBAC_Audit.md:381. Measured defaults: ~80-110 ms
# per verification on 8 cores. `parallelism` is baked into the hash rather than
# being a runtime knob, so the same hash costs the full serial ~350 ms on a
# single-core container -- plan capacity against that figure, not the parallel one.
# Memory is what resists GPU cracking; the floor is 64 MiB. Raising any of these is
# safe: existing hashes keep verifying and are upgraded on next successful login.
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST_KIB=65536
ARGON2_PARALLELISM=4

# A ceiling so a very long input cannot become a denial-of-service vector
# (12_Security_RBAC_Audit.md:394). The minimum length is production policy and is
# deliberately not set here.
PASSWORD_MAX_LENGTH=128

# Entropy behind each session secret. 32 bytes is a floor, not a preference: the
# stored digest is a fast unsalted hash, which is sound only because the input is
# uniform and large. No session *lifetime* setting exists -- that is ADR-SEC-002,
# which is Open.
SESSION_SECRET_BYTES=32

CELERY_QUEUES=files,exports,notifications,reports,maintenance,ai
CELERY_TASK_ALWAYS_EAGER=false
